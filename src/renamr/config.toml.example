# Global defaults (used when not overridden per inbox)
language = "en"
filename_template = "{date}_{sender}_{subject}"
# rename_prompt = "..."  # override the default prompt

# Per-inbox configuration (replaces the old inbox_paths list)
# Each [[inbox]] section can override: filename_template, language, rename_prompt
[[inbox]]
path = "/path/to/your/folder"

# Example: Multiple inboxes with different settings
# [[inbox]]
# path = "/Users/you/Documents/Rechnungen"
# filename_template = "{date}_{sender}_{subject}"
# language = "de"
#
# [[inbox]]
# path = "/Users/you/Documents/Scans"
# filename_template = "{date}_{subject}"
# rename_prompt = "Extract only date and subject. Ignore sender."
#
# Example: Use local Ollama for private documents (overrides global LLM settings)
# [[inbox]]
# path = "/Users/you/Documents/Private"
# model = "ollama/llama3.2"
# api_base = "http://localhost:11434"

[llm]
model = "gpt-4o-mini"
# api_base = ""  # leave empty for direct OpenAI; set for OpenRouter or local Ollama

# Example: Ollama local setup
# model = "ollama/gemma4:e2b"
# api_base = "http://localhost:11434"
# temperature = 0.2

temperature = 0.2
max_retries = 2
timeout = 120

[compress]
enabled = false
dpi = 150
jpeg_quality = 80

[logging]
level = "WARNING"
json_logs = false

# Ollama lifecycle configuration (optional)
# Controls automatic start/stop of Ollama server when using local models
[ollama]
auto_start = false       # Start Ollama automatically when an ollama/ model is configured
stop_after_run = true    # Stop Ollama after processing completes (only if we started it)
host = "http://localhost:11434"  # Ollama server URL for health checks
startup_timeout = 15     # Seconds to wait for Ollama to become ready after starting
